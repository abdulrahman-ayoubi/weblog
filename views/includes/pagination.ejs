<nav>
    <ul class="pagination justify-content-center">
        <% if (currentPage < 6){ %>
            <% if(numberOfPosts > 10) { %>
                <li class="page-item"><a class="btn btn-outline-primary <%= page === 1 ? ' active' : '' %>"
                                         href="?page=1">1</a></li>
            <% } %>
            <% if(numberOfPosts > 10) { %>
                <li class="page-item"><a class="btn btn-outline-primary <%= page === 2 ? ' active' : '' %>"
                                         href="?page=2">2</a>
                </li>
            <% } %>
            <% if(numberOfPosts >= 21) { %>
                <li class="page-item<%= page === 3 ? ' active' : '' %>"><a class="btn btn-outline-primary"
                                                                           href="?page=3">3</a>
                </li>
            <% } %>
            <% if(numberOfPosts >= 31) { %>
                <li class="page-item<%= page === 4 ? ' active' : '' %>"><a class="btn btn-outline-primary"
                                                                           href="?page=4">4</a>
                </li>
            <% } %>
            <% if(numberOfPosts >= 41) { %>
                <li class="page-item<%= page === 5 ? ' active' : '' %>"><a
                            class="btn btn-outline-primary" href="?page=5">5</a>
                </li>
            <% } %>
        <% }else { %>
            <% if(numberOfPosts) { %>
                <li class="page-item<%= page === 1 ? ' active' : '' %>"><a
                            class="btn btn-outline-primary" href="?page=1">1</a></li>
            <% } %>
            <% if(numberOfPosts > 20 ) { %>
                <li
                        class="page-item<%= page === 2 ? ' active' : '' %>">
                    <a class="btn btn-outline-primary" href="?page=2">2</a>
                </li>
            <% } %>
            <p class="text-center">...</p>

        <% } %>
        <% if(hasNextPage && currentPage !== 1 &&
                currentPage !== 2 && currentPage !== 3 &&
                currentPage !== 4 && currentPage !== 5) {
        %>
            <li class="page-item "><a
                        class="btn btn-outline-primary"
                        href="?page=<%= previousPage %>">
                    <%= previousPage %>
                </a>
            </li>
        <% } %>
        <% if(currentPage !== 1 &&
                currentPage !== 2 && currentPage
                !== 3 && currentPage !== 4 &&
                currentPage !== 5) { %>
            <li class="page-item active"><a
                        class="btn btn-outline-primary"
                        href="?page=<%= currentPage %>">
                    <%= currentPage %>
                </a>
            </li>
        <% } %>

        <% if(hasNextPage
                !== lastPage && lastPage
                !== currentPage && page
                !== 1 && page !== 2 &&
                page !== 3 && page !== 4)
        { %>
            <li class="page-item ">
                <a class="btn btn-outline-primary"
                   href="?page=<%= nextPage %>">
                    <%= nextPage %>
                </a>
            </li>
        <% } %>
        <% if (currentPage +
                3 < lastPage){
        %>
            <p
                    class="text-center">
                ...</p>
        <% } %>
        <% if
        (lastPage !== currentPage && nextPage !== lastPage && lastPage !== 2 && lastPage !== 3 && lastPage !== 4 && lastPage !== 5) {
        %>
            <li
                    class="page-item">
                <a class="btn btn-outline-primary"
                   href="?page=<%= lastPage %>">
                    <%= lastPage
                    %>
                </a>
            </li>
        <% } %>

    </ul>
</nav>