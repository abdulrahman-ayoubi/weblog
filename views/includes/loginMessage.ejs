<% if( message.length > 0) { %>
    <div class="success-message  alert  alert-success">
        <%= message %> <br>
        <button type="button" class="message-close alert-success" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true" title="Close">&times;</span>
        </button>
    </div>
<% } %>
<% if( errors.length > 0) { %>
    <div class="alert-warning alert  alert">
        <%= errors %> <br>
        <button type="button" class="message-close alert-success" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true" title="Close">&times;</span>
        </button>
    </div>
<% } %>

