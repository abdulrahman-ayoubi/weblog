<% if( message.length > 0) { %>
    <div class="blog-message success-message w-100 d-flex text-center justify-content-center  p-4  alert  alert-success">
        <div>
            <p class="blog-p">
                <%= message %>
            </p>
        </div>
        <div class="d-flex align-items-center">
            <button type="button" class="mb-3 btn message-close alert-success" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true" title="Close">&times;</span>
            </button>
        </div>
    </div>
<% } %>